<%- include('../partials/admin-layout-top') %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <% const cards = [['Doanh thu', fmt(stats.revenue), 'payments', 'text-emerald-600'],['Đơn hàng', stats.orders, 'receipt_long', 'text-blue-600'],['Chờ xử lý', stats.pending, 'pending', 'text-amber-600'],['Sản phẩm', stats.products, 'inventory_2', 'text-primary']]; %>
  <% cards.forEach(c => { %>
  <div class="bg-surface-container-lowest rounded-2xl p-5 border border-surface-container-high shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-xs text-secondary font-semibold uppercase tracking-wider"><%= c[0] %></span>
      <span class="material-symbols-outlined <%= c[3] %>"><%= c[2] %></span>
    </div>
    <p class="text-2xl font-extrabold mt-2"><%= c[1] %></p>
  </div>
  <% }) %>
</div>

<div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high shadow-sm overflow-hidden">
  <div class="px-5 py-4 border-b border-surface-container-high flex items-center justify-between">
    <h2 class="font-bold">Đơn hàng gần đây</h2>
    <a href="/admin/orders" class="text-sm text-primary font-semibold">Xem tất cả</a>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-surface-container text-secondary text-xs uppercase">
        <tr><th class="text-left px-5 py-3">Mã đơn</th><th class="text-left px-5 py-3">Khách hàng</th><th class="text-left px-5 py-3">Tổng</th><th class="text-left px-5 py-3">Trạng thái</th><th class="text-left px-5 py-3"></th></tr>
      </thead>
      <tbody>
        <% if (recentOrders.length === 0) { %>
          <tr><td colspan="5" class="px-5 py-8 text-center text-secondary">Chưa có đơn hàng nào.</td></tr>
        <% } %>
        <% recentOrders.forEach(o => { %>
        <tr class="border-t border-surface-container-high">
          <td class="px-5 py-3 font-semibold">#<%= o.code %></td>
          <td class="px-5 py-3"><%= o.customer_name %></td>
          <td class="px-5 py-3 font-semibold text-primary"><%= fmt(o.total) %></td>
          <td class="px-5 py-3"><%- include('../partials/status', { status: o.status }) %></td>
          <td class="px-5 py-3"><a href="/admin/orders/<%= o.id %>" class="text-primary text-xs font-semibold">Chi tiết</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/admin-layout-bottom') %>
