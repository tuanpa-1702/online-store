<%- include('../partials/admin-layout-top') %>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
  <!-- Folders -->
  <aside class="lg:col-span-3 bg-surface-container-lowest rounded-2xl border border-surface-container-high shadow-sm p-4">
    <h2 class="font-bold text-sm mb-3">Thư mục</h2>
    <div class="flex flex-col gap-1">
      <% if (!folders.length) { %><p class="text-xs text-secondary">Chưa có thư mục.</p><% } %>
      <% folders.forEach(f => { %>
        <a href="/admin/media?folder=<%= encodeURIComponent(f) %>" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm <%= f === current ? 'bg-primary text-on-primary' : 'text-secondary hover:bg-surface-container' %>">
          <span class="material-symbols-outlined text-[18px]">folder</span> <%= f %>
        </a>
      <% }) %>
    </div>
    <form action="/admin/media/folder" method="post" class="mt-4 pt-4 border-t border-surface-container-high flex gap-2">
      <input name="name" placeholder="Tên thư mục mới" required class="flex-1 min-w-0 px-3 py-2 rounded-lg border border-outline-variant bg-surface outline-none focus:border-primary text-sm">
      <button class="px-3 py-2 rounded-lg bg-primary text-on-primary text-sm font-semibold hover:bg-primary-container shrink-0">Tạo</button>
    </form>
  </aside>

  <!-- Files -->
  <section class="lg:col-span-9">
    <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high shadow-sm p-4 mb-5">
      <form action="/admin/media/upload?folder=<%= encodeURIComponent(current) %>" method="post" enctype="multipart/form-data" class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <div class="flex-1">
          <label class="text-xs font-semibold text-secondary">Tải ảnh lên thư mục <strong class="text-primary"><%= current %></strong> (chọn nhiều ảnh)</label>
          <input name="files" type="file" accept="image/*" multiple required class="w-full mt-1 text-sm">
        </div>
        <button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-semibold hover:bg-primary-container shrink-0 flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px]">upload</span> Tải lên</button>
      </form>
    </div>

    <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high shadow-sm p-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-sm">Ảnh trong "<%= current %>" (<%= files.length %>)</h2>
      </div>
      <% if (!files.length) { %>
        <p class="text-sm text-secondary text-center py-10">Thư mục trống. Tải ảnh lên ở trên.</p>
      <% } else { %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        <% files.forEach(f => { %>
        <div class="border border-surface-container-high rounded-xl overflow-hidden group relative">
          <div class="aspect-square bg-white"><img src="<%= f.url %>" class="w-full h-full object-contain"></div>
          <div class="p-2 flex items-center justify-between gap-1">
            <button type="button" onclick="navigator.clipboard.writeText(location.origin + '<%= f.url %>').then(()=>{this.innerText='Đã copy'})" class="text-[11px] text-secondary hover:text-primary truncate">Copy URL</button>
            <form action="/admin/media/delete" method="post" onsubmit="return confirm('Xóa ảnh này?')">
              <input type="hidden" name="url" value="<%= f.url %>">
              <input type="hidden" name="folder" value="<%= current %>">
              <button class="text-secondary hover:text-primary flex items-center"><span class="material-symbols-outlined text-[18px]">delete</span></button>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </section>
</div>
<%- include('../partials/admin-layout-bottom') %>
