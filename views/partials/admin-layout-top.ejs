<!DOCTYPE html>
<html lang="vi">
<head>
<script>(function(){try{var t=localStorage.getItem('theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();</script>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title><%= title %> • Quản trị <%= settings.site_name || 'Chợ Trời' %></title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: { colors: {
    primary: '#972b25', 'primary-container': '#b8433a', 'on-primary': '#ffffff',
    background: '#fff8f6', surface: '#fff8f6', 'surface-container-low': '#fbf2f0',
    'surface-container': '#f5ecea', 'surface-container-high': '#efe6e4',
    'surface-container-highest': '#e9e1df', 'surface-container-lowest': '#ffffff',
    'on-surface': '#1e1b1a', secondary: '#615d5d', 'outline-variant': '#dfbfbc',
    outline: '#8b716e', 'inverse-surface': '#342f2e',
  }, fontFamily: { sans: ['Be Vietnam Pro','sans-serif'], display: ['Be Vietnam Pro','sans-serif'] } } } };
</script>
<style>
  html{font-family:'Be Vietnam Pro',sans-serif;color:#1e1b1a}
  .font-display{font-family:'Be Vietnam Pro',sans-serif;font-weight:700}
  ::-webkit-scrollbar{width:0}
  :root{--glass-bg:rgba(255,255,255,0.58);--glass-strong:rgba(255,255,255,0.80);--glass-brd:rgba(255,255,255,0.60);}
  body{background:linear-gradient(135deg,#fff5f2 0%,#fdebe7 45%,#fbeee9 100%);background-attachment:fixed;min-height:100vh;}
  body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(620px circle at 8% 6%,rgba(151,43,37,0.12),transparent 60%),radial-gradient(560px circle at 92% 90%,rgba(255,170,150,0.18),transparent 62%);}
  .bg-surface-container-lowest,.bg-surface-container-low,.bg-surface-container,.bg-surface-container-high,.bg-surface-container-highest,.bg-surface{background-color:var(--glass-bg)!important;backdrop-filter:blur(14px) saturate(150%);-webkit-backdrop-filter:blur(14px) saturate(150%);}
  .border-surface-container-high,.border-surface-container,.border-outline-variant{border-color:var(--glass-brd)!important;}
  header.sticky{background:rgba(255,248,246,0.60)!important;-webkit-backdrop-filter:blur(16px) saturate(160%);backdrop-filter:blur(16px) saturate(160%);}
  .bg-white{background-color:#ffffff!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;}
  html[data-theme="dark"]{--glass-bg:rgba(38,28,27,0.58);--glass-strong:rgba(48,36,34,0.78);--glass-brd:rgba(255,255,255,0.10);}
  html[data-theme="dark"] body{background:linear-gradient(135deg,#1a1413 0%,#221917 50%,#1c1513 100%);}
  html[data-theme="dark"] body::before{background:radial-gradient(620px circle at 8% 6%,rgba(184,67,58,0.18),transparent 60%),radial-gradient(560px circle at 92% 90%,rgba(120,40,34,0.22),transparent 62%);}
  html[data-theme="dark"] header.sticky{background:rgba(26,20,19,0.62)!important;}
  html[data-theme="dark"] .text-on-surface{color:#f2e9e7!important;}
  html[data-theme="dark"] .text-secondary{color:#b4a8a5!important;}
  html[data-theme="dark"] input,html[data-theme="dark"] textarea,html[data-theme="dark"] select{color:#f2e9e7;}
  html[data-theme="dark"] ::placeholder{color:#9b8f8c!important;}
  html[data-theme="dark"] [class*="bg-surface/"]{background-color:rgba(38,28,27,0.85)!important;}
  html[data-theme="dark"] .text-primary{color:#e8655a!important;}
  html[data-theme="dark"] select,html[data-theme="dark"] input,html[data-theme="dark"] textarea{color-scheme:dark;color:#f2e9e7;}
  html[data-theme="dark"] option{background-color:#241b19;color:#f2e9e7;}
  input[type="radio"],input[type="checkbox"]{accent-color:#972b25;}
  html[data-theme="dark"] input[type="radio"],html[data-theme="dark"] input[type="checkbox"]{accent-color:#e8655a;}
  .gs-btn{display:inline-flex;align-items:center;gap:.4rem;justify-content:space-between;}
  .gs-btn .gs-caret{font-size:18px;opacity:.6;margin-left:auto;transition:transform .15s;}
  .gs-btn.gs-open .gs-caret{transform:rotate(180deg);}
  .gs-panel{background:var(--glass-strong,rgba(255,255,255,0.8));color:#1e1b1a;backdrop-filter:blur(18px) saturate(170%);-webkit-backdrop-filter:blur(18px) saturate(170%);border:1px solid var(--glass-brd);border-radius:16px;padding:6px;box-shadow:0 16px 48px rgba(60,20,16,0.22);z-index:9999;max-height:62vh;overflow:auto;}
  .gs-opt{display:flex;align-items:center;gap:8px;width:100%;text-align:left;padding:10px 12px;border-radius:10px;font-size:14px;color:inherit;background:transparent;cursor:pointer;white-space:nowrap;}
  .gs-opt:hover{background:rgba(151,43,37,0.10);}
  .gs-opt.gs-sel{color:#972b25;font-weight:600;}
  .gs-check{font-size:18px;color:#972b25;}
  .gs-check-sp{width:18px;display:inline-block;}
  html[data-theme="dark"] .gs-panel{color:#f2e9e7;}
  html[data-theme="dark"] .gs-opt:hover{background:rgba(232,101,90,0.16);}
  html[data-theme="dark"] .gs-opt.gs-sel,html[data-theme="dark"] .gs-check{color:#e8655a;}
  .frost-pop{background:rgba(255,248,246,0.93)!important;backdrop-filter:blur(22px) saturate(160%);-webkit-backdrop-filter:blur(22px) saturate(160%);box-shadow:0 16px 48px rgba(60,20,16,0.20);}
  html[data-theme="dark"] .frost-pop{background:rgba(32,24,22,0.94)!important;box-shadow:0 16px 48px rgba(0,0,0,0.45);}
</style>
</head>
<body class="bg-background text-on-surface min-h-screen">
<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="w-60 bg-inverse-surface text-white flex flex-col shrink-0 fixed md:sticky top-0 h-screen z-30 -translate-x-full md:translate-x-0 transition-transform" id="adminSidebar">
    <div class="p-5 border-b border-white/10">
      <a href="/admin" class="flex items-center font-display font-semibold text-xl"><%= settings.site_name || 'Chợ Trời' %></a>
      <p class="text-[11px] text-white/50 mt-1 uppercase tracking-widest">Trang quản trị</p>
    </div>
    <nav class="flex-1 p-3 space-y-1 text-sm">
      <% const nav = [
        ['dashboard','Tổng quan','/admin','dashboard', false],
        ['inventory_2','Sản phẩm','/admin/products','products', false],
        ['perm_media','Thư viện ảnh','/admin/media','media', false],
        ['receipt_long','Đơn hàng','/admin/orders','orders', false],
        ['group','Người dùng','/admin/users','users', true],
        ['settings','Cấu hình','/admin/settings','settings', true],
      ]; %>
      <% nav.filter(n => !n[4] || isAdminUser).forEach(n => { %>
        <a href="<%= n[2] %>" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition <%= page === n[3] ? 'bg-primary text-on-primary' : 'text-white/70 hover:bg-white/10' %>">
          <span class="material-symbols-outlined text-[20px]"><%= n[0] %></span> <span class="flex-1"><%= n[1] %></span>
          <% if (n[3] === 'orders' && typeof unseenCount !== 'undefined' && unseenCount > 0) { %>
            <span class="js-order-badge bg-red-500 text-white text-[11px] font-bold rounded-full h-5 min-w-[20px] px-1.5 flex items-center justify-center"><%= unseenCount %></span>
          <% } else if (n[3] === 'orders') { %>
            <span class="js-order-badge hidden bg-red-500 text-white text-[11px] font-bold rounded-full h-5 min-w-[20px] px-1.5 flex items-center justify-center">0</span>
          <% } %>
        </a>
      <% }) %>
    </nav>
    <div class="p-3 border-t border-white/10">
      <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/70 hover:bg-white/10 text-sm"><span class="material-symbols-outlined text-[20px]">storefront</span> Xem cửa hàng</a>
      <a href="/logout" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/70 hover:bg-white/10 text-sm"><span class="material-symbols-outlined text-[20px]">logout</span> Đăng xuất</a>
    </div>
  </aside>

  <!-- Main -->
  <div class="flex-1 min-w-0">
    <header class="bg-surface-container-lowest border-b border-surface-container-high sticky top-0 z-20 px-5 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <button onclick="document.getElementById('adminSidebar').classList.toggle('-translate-x-full')" class="md:hidden w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-container"><span class="material-symbols-outlined">menu</span></button>
        <h1 class="font-bold text-lg"><%= title %></h1>
      </div>
      <div class="flex items-center gap-3 text-sm">
        <button type="button" id="themeToggle" onclick="toggleTheme()" aria-label="Chế độ tối" class="w-10 h-10 flex items-center justify-center rounded-lg text-on-surface hover:opacity-70 transition-opacity">
          <span class="material-symbols-outlined" id="themeIcon">dark_mode</span>
        </button>
        <details class="account-menu relative">
          <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer relative w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-container">
            <span class="material-symbols-outlined">notifications</span>
            <span class="js-bell-badge <%= (typeof unseenCount !== 'undefined' && unseenCount > 0) ? '' : 'hidden' %> absolute top-1 right-1 bg-red-500 text-white text-[10px] font-bold rounded-full h-4 min-w-[16px] px-1 flex items-center justify-center"><%= typeof unseenCount !== 'undefined' ? unseenCount : 0 %></span>
          </summary>
          <div class="frost-pop absolute right-0 top-12 w-80 bg-surface-container-lowest rounded-xl shadow-lg border border-surface-container-high z-50 overflow-hidden">
            <div class="px-4 py-3 border-b border-surface-container-high flex items-center justify-between">
              <span class="font-semibold text-sm">Đơn hàng mới</span>
              <% if (typeof unseenCount !== 'undefined' && unseenCount > 0) { %>
                <form action="/admin/notifications/seen" method="post"><button class="text-xs text-primary hover:underline">Đánh dấu đã xem</button></form>
              <% } %>
            </div>
            <div class="js-bell-list max-h-80 overflow-y-auto">
              <% if (typeof unseenOrders === 'undefined' || !unseenOrders.length) { %>
                <p class="px-4 py-6 text-sm text-secondary text-center">Không có đơn mới.</p>
              <% } else { %>
                <% unseenOrders.forEach(o => { %>
                <a href="/admin/orders/<%= o.id %>" class="block px-4 py-3 hover:bg-surface-container border-b border-surface-container-high last:border-0">
                  <div class="flex items-center justify-between"><span class="font-semibold text-sm">#<%= o.code %></span><span class="text-primary font-semibold text-sm"><%= fmt(o.total) %></span></div>
                  <p class="text-xs text-secondary"><%= o.customer_name %> · <%= o.created_at %></p>
                </a>
                <% }) %>
              <% } %>
            </div>
          </div>
        </details>
        <span class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold"><%= (currentUser.name || 'A').charAt(0).toUpperCase() %></span>
        <span class="hidden sm:inline text-secondary"><%= currentUser.name %></span>
      </div>
    </header>
    <main class="p-5 md:p-8">
