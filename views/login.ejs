<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="flex-grow flex items-center justify-center px-5 py-12 w-full">
  <div class="w-full max-w-md bg-surface-container-lowest rounded-3xl p-8 border border-surface-container-high shadow-sm">
    <div class="text-center mb-6">
      <div class="mb-2">
        <span class="font-display font-semibold text-2xl text-on-surface"><%= settings.site_name || 'Chợ Trời' %></span>
      </div>
      <h1 class="text-xl font-display font-semibold text-on-surface"><%= mode === 'register' ? 'Tạo tài khoản mới' : 'Đăng nhập tài khoản' %></h1>
      <p class="text-sm text-secondary mt-1"><%= mode === 'register' ? 'Đăng ký để mua sắm nhanh hơn.' : 'Chào mừng bạn trở lại Chợ Trời.' %></p>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 text-primary px-4 py-3 rounded-xl text-sm mb-4 border border-outline-variant"><%= error %></div>
    <% } %>

    <a href="/auth/google" class="w-full flex items-center justify-center gap-3 py-3 rounded-xl border border-outline-variant bg-surface hover:bg-surface-container transition font-semibold text-sm">
      <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-5 h-5" alt="Google">
      Tiếp tục với Google
    </a>

    <div class="flex items-center gap-3 my-5">
      <span class="h-px bg-surface-container-high flex-1"></span>
      <span class="text-xs text-secondary">hoặc dùng email</span>
      <span class="h-px bg-surface-container-high flex-1"></span>
    </div>

    <form action="<%= mode === 'register' ? '/register' : '/login' %>" method="post" class="flex flex-col gap-3">
      <% if (mode === 'register') { %>
        <div>
          <label class="text-xs font-semibold text-secondary">Họ tên</label>
          <input name="name" value="<%= form.name || '' %>" class="w-full mt-1 px-4 py-2.5 rounded-xl border border-outline-variant bg-surface outline-none focus:border-primary text-sm">
        </div>
      <% } %>
      <div>
        <label class="text-xs font-semibold text-secondary">Email</label>
        <input name="email" type="email" required value="<%= form.email || '' %>" class="w-full mt-1 px-4 py-2.5 rounded-xl border border-outline-variant bg-surface outline-none focus:border-primary text-sm">
      </div>
      <div>
        <label class="text-xs font-semibold text-secondary">Mật khẩu</label>
        <input name="password" type="password" required class="w-full mt-1 px-4 py-2.5 rounded-xl border border-outline-variant bg-surface outline-none focus:border-primary text-sm">
      </div>
      <button type="submit" class="w-full mt-2 py-3 rounded-xl bg-primary text-on-primary font-semibold text-sm hover:bg-primary-container transition"><%= mode === 'register' ? 'Đăng ký' : 'Đăng nhập' %></button>
    </form>

    <p class="text-center text-sm text-secondary mt-5">
      <% if (mode === 'register') { %>
        Đã có tài khoản? <a href="/login" class="text-primary font-semibold">Đăng nhập</a>
      <% } else { %>
        Chưa có tài khoản? <a href="/register" class="text-primary font-semibold">Đăng ký ngay</a>
      <% } %>
    </p>
  </div>
</main>
<%- include('partials/footer') %>
