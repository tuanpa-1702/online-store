<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="flex-grow max-w-[1360px] mx-auto px-5 md:px-8 py-8 w-full">
  <nav class="flex items-center gap-2 text-xs text-secondary mb-8 font-medium">
    <a class="hover:text-on-surface" href="/">Trang chủ</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a class="hover:text-on-surface" href="/?category=<%= encodeURIComponent(product.category) %>#products"><%= product.category %></a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-on-surface font-semibold line-clamp-1"><%= product.name %></span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <!-- Gallery -->
    <div class="lg:col-span-7 flex flex-col gap-4">
      <div id="zoomWrap" class="relative rounded-3xl overflow-hidden bg-surface-container-lowest shadow-sm border border-surface-container-high p-2 md:cursor-zoom-in select-none">
        <img id="mainImage" src="<%= images[0] %>" alt="<%= product.name %>" class="w-full h-auto max-h-[72vh] object-contain rounded-2xl transition-transform duration-150 ease-out will-change-transform" style="transform-origin:center center;">
        <% if (product.badge) { %>
        <span class="absolute top-6 left-6 bg-inverse-surface text-white text-[11px] font-semibold uppercase tracking-wider px-3 py-1.5 rounded-full pointer-events-none"><%= product.badge %></span>
        <% } %>
        <span id="zoomHint" class="absolute bottom-4 right-4 bg-surface/90 text-secondary text-[11px] font-medium px-2.5 py-1 rounded-full pointer-events-none flex items-center gap-1 shadow-sm">
          <span class="material-symbols-outlined text-[14px]">zoom_in</span> Rê chuột để phóng to
        </span>
      </div>
      <% if (images.length > 1) { %>
      <div class="grid grid-cols-5 gap-3">
        <% images.forEach((im, i) => { %>
        <button type="button" onclick="setMain('<%= im %>', this)" data-thumb class="aspect-square rounded-2xl overflow-hidden bg-surface-container-lowest p-2 border-2 <%= i===0?'border-primary':'border-transparent hover:border-outline-variant' %> transition shadow-sm">
          <img src="<%= im %>" class="w-full h-full object-contain rounded-xl pointer-events-none">
        </button>
        <% }) %>
      </div>
      <% } %>
    </div>

    <!-- Purchase -->
    <div class="lg:col-span-5 flex flex-col gap-5">
      <div>
        <span class="text-xs font-bold tracking-widest text-primary uppercase bg-surface-container-highest px-2.5 py-1 rounded-full"><%= product.category %></span>
        <h1 class="font-display text-3xl font-semibold text-on-surface leading-snug mt-3"><%= product.name %></h1>
        <div class="flex items-center gap-4 mt-3">
          <div class="flex items-center gap-1 bg-surface-container-highest px-2 py-0.5 rounded text-primary text-xs font-bold">
            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings:'FILL' 1;">star</span><span><%= product.rating %></span>
          </div>
          <span class="text-xs text-secondary"><%= product.reviews %> đánh giá</span>
          <span class="text-secondary">•</span>
          <span class="text-xs text-emerald-600 font-medium">Đã bán <%= product.sold %>+</span>
        </div>
      </div>

      <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container-high shadow-sm flex items-center justify-between">
        <div>
          <div class="flex items-baseline gap-3">
            <span class="text-3xl font-extrabold text-primary"><%= fmt(product.price) %></span>
            <% if (product.old_price) { %><span class="text-base text-secondary line-through"><%= fmt(product.old_price) %></span><% } %>
          </div>
          <p class="text-xs text-secondary mt-1">Đã bao gồm VAT & Miễn phí vận chuyển toàn quốc</p>
        </div>
        <% if (product.old_price) { %>
        <span class="bg-surface-container-highest text-primary font-bold text-xs px-3 py-1.5 rounded-full">-<%= Math.round((1-product.price/product.old_price)*100) %>%</span>
        <% } %>
      </div>

      <% if (product.tags) { %>
      <div class="flex flex-wrap gap-2">
        <% product.tags.split(',').forEach(t => { %>
          <span class="bg-surface-container px-3 py-1 rounded-lg text-xs text-secondary font-medium"><%= t.trim() %></span>
        <% }) %>
      </div>
      <% } %>

      <div class="flex items-center justify-between pt-2">
        <div class="flex items-center border border-surface-container-high rounded-xl bg-surface-container-lowest overflow-hidden">
          <button type="button" onclick="chQty(-1)" class="w-10 h-10 flex items-center justify-center text-secondary hover:bg-surface-container"><span class="material-symbols-outlined text-[18px]">remove</span></button>
          <span id="qtyVal" class="w-12 text-center text-sm font-semibold">1</span>
          <button type="button" onclick="chQty(1)" class="w-10 h-10 flex items-center justify-center text-secondary hover:bg-surface-container"><span class="material-symbols-outlined text-[18px]">add</span></button>
        </div>
        <% if (product.stock > 0) { %>
          <span class="text-xs font-medium text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Còn <%= product.stock %> sản phẩm</span>
        <% } else { %>
          <span class="text-xs font-medium text-primary bg-surface-container-highest px-3 py-1.5 rounded-full">Tạm hết hàng</span>
        <% } %>
      </div>

      <% if (product.stock > 0) { %>
      <div class="flex items-center justify-between bg-surface-container-low rounded-2xl px-5 py-3.5">
        <span class="text-sm text-secondary">Tạm tính (<span id="qtyLabel">1</span> sản phẩm)</span>
        <span id="totalPrice" class="font-display text-xl font-bold text-primary"><%= fmt(product.price) %></span>
      </div>
      <% } %>

      <form action="/cart/add" method="post" id="buyForm" class="flex flex-col sm:flex-row gap-3 pt-2">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <input type="hidden" name="qty" id="qtyInput" value="1">
        <button type="submit" formaction="/cart/add" <%= product.stock<=0?'disabled':'' %> class="flex-1 py-3.5 px-6 rounded-2xl bg-inverse-surface text-white font-medium text-sm flex items-center justify-center gap-2 hover:bg-black shadow-md transition disabled:opacity-40">
          <span class="material-symbols-outlined text-[20px]">shopping_bag</span> Thêm vào giỏ
        </button>
        <button type="submit" formaction="/cart/add" name="redirect" value="/checkout" <%= product.stock<=0?'disabled':'' %> class="flex-1 py-3.5 px-6 rounded-2xl bg-primary text-on-primary font-medium text-sm flex items-center justify-center gap-2 hover:bg-primary-container shadow-md transition disabled:opacity-40">
          <span class="material-symbols-outlined text-[20px]">bolt</span> Mua ngay
        </button>
      </form>

      <%
        let feats = [];
        try { feats = JSON.parse(product.features || '[]'); } catch (e) {}
        if (!feats.length) feats = [{icon:'verified_user',text:'Bảo hành 2 năm'},{icon:'local_shipping',text:'Giao nhanh 24H'},{icon:'sync',text:'30 ngày đổi trả'}];
      %>
      <% if (feats.length) { %>
      <div class="grid grid-cols-<%= Math.min(feats.length,3) %> gap-3 p-4 rounded-2xl bg-surface-container-lowest border border-surface-container-high text-center">
        <% feats.slice(0,3).forEach(f => { %>
        <div><span class="material-symbols-outlined text-primary text-[24px]"><%= f.icon || 'verified_user' %></span><p class="text-xs font-semibold mt-1"><%= f.text %></p></div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Description -->
  <section class="mt-14 bg-surface-container-lowest rounded-3xl p-8 border border-surface-container-high shadow-sm">
    <h2 class="font-display text-xl font-semibold text-on-surface mb-4">Mô tả sản phẩm</h2>
    <p class="text-sm text-secondary leading-relaxed whitespace-pre-line"><%= product.long_description || product.description %></p>
  </section>

  <!-- Reviews -->
  <% if (typeof reviews !== 'undefined' && reviews.length) { %>
  <section class="mt-14">
    <h2 class="font-display text-xl font-semibold text-on-surface mb-6">Đánh giá từ khách hàng (<%= reviews.length %>)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% reviews.forEach(r => { %>
      <div class="bg-surface-container-lowest rounded-2xl p-5 border border-surface-container-high shadow-sm">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-on-surface"><%= r.user_name || 'Khách hàng' %></span>
          <span class="flex items-center">
            <% for (let i=1;i<=5;i++) { %><span class="material-symbols-outlined text-[16px] <%= i<=r.rating?'text-amber-500':'text-outline-variant' %>" style="font-variation-settings:'FILL' 1;">star</span><% } %>
          </span>
        </div>
        <% if (r.comment) { %><p class="text-sm text-secondary mt-2"><%= r.comment %></p><% } %>
        <p class="text-xs text-secondary mt-1"><%= r.created_at %></p>
      </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- Related -->
  <% if (related.length) { %>
  <section class="mt-14">
    <h2 class="font-display text-xl font-semibold text-on-surface mb-6">Sản phẩm liên quan</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      <% related.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
    </div>
  </section>
  <% } %>
</main>
<script>
  // --- Gallery: thumbnail -> main image ---
  function setMain(src, el) {
    var main = document.getElementById('mainImage');
    main.style.transform = 'scale(1)';
    main.src = src;
    document.querySelectorAll('[data-thumb]').forEach(function (b) {
      b.classList.remove('border-primary');
      b.classList.add('border-transparent');
    });
    if (el) { el.classList.add('border-primary'); el.classList.remove('border-transparent'); }
  }

  // --- Magnifier zoom on hover (desktop) ---
  (function () {
    var wrap = document.getElementById('zoomWrap');
    var img = document.getElementById('mainImage');
    var hint = document.getElementById('zoomHint');
    if (!wrap || !img) return;
    var ZOOM = 2.4;
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (!canHover) { if (hint) hint.style.display = 'none'; return; }
    wrap.addEventListener('mousemove', function (e) {
      var r = wrap.getBoundingClientRect();
      var x = ((e.clientX - r.left) / r.width) * 100;
      var y = ((e.clientY - r.top) / r.height) * 100;
      img.style.transformOrigin = x + '% ' + y + '%';
      img.style.transform = 'scale(' + ZOOM + ')';
      if (hint) hint.style.opacity = '0';
    });
    wrap.addEventListener('mouseleave', function () {
      img.style.transform = 'scale(1)';
      img.style.transformOrigin = 'center center';
      if (hint) hint.style.opacity = '1';
    });
  })();

  let q = 1;
  var UNIT_PRICE = <%= product.price %>;
  var MAX_STOCK = <%= Math.max(1, product.stock) %>;
  function fmtVND(n){ return (Number(n)||0).toLocaleString('vi-VN') + '₫'; }
  function chQty(d){
    q = Math.max(1, Math.min(MAX_STOCK, q + d));
    document.getElementById('qtyVal').innerText = q;
    document.getElementById('qtyInput').value = q;
    var label = document.getElementById('qtyLabel');
    var total = document.getElementById('totalPrice');
    if (label) label.innerText = q;
    if (total) total.innerText = fmtVND(UNIT_PRICE * q);
  }
</script>
<%- include('partials/footer') %>
