<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="flex-grow max-w-[800px] mx-auto px-5 md:px-8 py-8 w-full">
  <a href="/account" class="text-sm text-secondary hover:text-on-surface flex items-center gap-1 mb-4"><span class="material-symbols-outlined text-[18px]">arrow_back</span> Quay lại</a>
  <div class="flex items-center justify-between gap-3 mb-6 flex-wrap">
    <h1 class="font-display text-2xl font-semibold text-on-surface">Đơn hàng #<%= order.code %></h1>
    <div class="flex items-center gap-2">
      <%- include('partials/payment-badge', { order }) %>
      <%- include('partials/status', { status: order.status }) %>
    </div>
  </div>

  <div class="bg-surface-container-lowest rounded-2xl p-6 border border-surface-container-high shadow-sm mb-6">
    <h2 class="font-bold text-on-surface mb-5">Tiến độ đơn hàng</h2>
    <%- include('partials/order-timeline', { order, history }) %>
  </div>

  <% if (order.payment_method === 'bank' && order.payment_status !== 'paid') { %>
  <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant shadow-sm mb-6">
    <div class="flex flex-col sm:flex-row gap-6 items-start">
      <%- include('partials/qr-pay', { amount: order.total, addInfo: order.code, dl: order.code }) %>
      <div class="flex-1">
        <p class="text-sm text-secondary mb-1">Chuyển khoản theo mã QR (đã gồm số tiền <strong class="text-primary"><%= fmt(order.total) %></strong>, nội dung <strong class="text-primary"><%= order.code %></strong>).</p>
        <% if (order.payment_status === 'reported') { %>
          <p class="text-sm text-blue-700 bg-blue-50 rounded-lg px-3 py-2 my-3">Bạn đã báo chuyển khoản, shop đang kiểm tra.</p>
        <% } else { %>
        <form action="/order/<%= order.code %>/paid-report" method="post" class="mt-3" onsubmit="return confirm('Xác nhận bạn đã chuyển khoản?')">
          <button class="px-6 py-3 rounded-xl bg-primary text-on-primary font-semibold text-sm hover:bg-primary-container flex items-center gap-2"><span class="material-symbols-outlined text-[20px]">paid</span> Tôi đã chuyển khoản</button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <div class="bg-surface-container-lowest rounded-2xl p-6 border border-surface-container-high shadow-sm">
    <div class="flex flex-col gap-3">
      <% items.forEach(it => { %>
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-lg overflow-hidden bg-surface-container-low shrink-0"><img src="<%= it.image %>" class="w-full h-full object-cover"></div>
        <p class="text-sm flex-1"><%= it.name %> <span class="text-secondary">× <%= it.qty %></span></p>
        <p class="text-sm font-semibold"><%= fmt(it.price * it.qty) %></p>
      </div>
      <% }) %>
    </div>
    <div class="border-t border-surface-container-high mt-4 pt-4 space-y-2 text-sm">
      <div class="flex justify-between"><span class="text-secondary">Tạm tính</span><span><%= fmt(order.subtotal) %></span></div>
      <div class="flex justify-between"><span class="text-secondary">Vận chuyển</span><span><%= order.shipping === 0 ? 'Miễn phí' : fmt(order.shipping) %></span></div>
      <div class="flex justify-between font-bold text-base"><span>Tổng cộng</span><span class="text-primary"><%= fmt(order.total) %></span></div>
    </div>
    <div class="border-t border-surface-container-high mt-4 pt-4 text-sm text-secondary space-y-1">
      <p><strong class="text-on-surface">Người nhận:</strong> <%= order.customer_name %> • <%= order.phone %></p>
      <p><strong class="text-on-surface">Địa chỉ:</strong> <%= order.address %></p>
      <p><strong class="text-on-surface">Thanh toán:</strong> <%= order.payment_method === 'bank' ? 'Chuyển khoản' : 'COD' %></p>
      <% if (order.note) { %><p><strong class="text-on-surface">Ghi chú:</strong> <%= order.note %></p><% } %>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
